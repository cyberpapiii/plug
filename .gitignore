/target
**/*.rs.bk
*.swp
*.swo
.DS_Store
.continues-handoff.md
.compound-engineering/*.local.yaml
/.worktrees/
/node_modules/
/test-results/
/playwright-report/
/blob-report/

# Credentials and local runtime state. plug stores real config and tokens
# outside the repo; these patterns keep a stray copy from ever being committed.
config.toml
config.toml.*
.env
.env.*
credentials*.json
/tokens/
*.pem
*.key
*.p12
*.pfx
*.keychain
id_rsa*
id_ecdsa*
id_ed25519*
.netrc

# Coverage instrumentation artifacts, dropped in the working tree by
# instrumented test runs. Regenerated on demand; never worth committing.
*.profraw
*.profdata
