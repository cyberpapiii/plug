      "type": "GetServerConfig",
      "name": "workspace"
    }
  },
  "handshake": {
    "type": "OperatorHandshake",
    "client_version": "0.9.0"
  },
  "import_servers": {
    "type": "Operator",
    "auth_token": "golden-auth-token",
    "request": {
      "type": "Mutate",
